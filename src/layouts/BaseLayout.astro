---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import personal from '../../content/personal.json';
import { getSafeExternalUrl } from '../utils/safeLinks';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | ${personal.name}` : `${personal.name} - ${personal.role}`;
const pageDescription = description || 'Portifolio focado em DevOps, SRE e Cloud, com projetos de infraestrutura moderna, observabilidade e automacao.';
const siteUrl = Astro.site ? Astro.site.toString() : personal.siteUrl;
const ogImage = new URL(`${base}og.svg`, siteUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
const githubUrl = getSafeExternalUrl(personal.links.github);
const linkedinUrl = getSafeExternalUrl(personal.links.linkedin);
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const preferredTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = storedTheme || preferredTheme;
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {googleSiteVerification ? (
      <meta name="google-site-verification" content={googleSiteVerification} />
    ) : null}
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Pular para conteudo</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={base} aria-label="Ir para a home">{personal.name}</a>
        <nav class="nav-links" aria-label="Principal">
          <a href={base}>Home</a>
          <a href={`${base}projects/`}>Projects</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}#contact`}>Contact</a>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-links">
          {githubUrl ? (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub (link externo, abre em nova aba)"
            >
              GitHub
            </a>
          ) : null}
          {linkedinUrl ? (
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn (link externo, abre em nova aba)"
            >
              LinkedIn
            </a>
          ) : null}
          <a href={`${base}projects/`}>Projetos</a>
          <a href={`${base}about/`}>Sobre</a>
        </div>
        <small>(c) 2026 {personal.name}. </small>
        <small class="ai-disclosure">
          Conteúdo feito por auxílio de Inteligência Artificial com revisão humana ({personal.name}).
        </small>
      </div>
    </footer>
    <p class="external-notice" data-external-notice role="status" aria-live="polite" aria-atomic="true" hidden></p>
    <script is:inline>
      const externalNotice = document.querySelector('[data-external-notice]');
      let externalNoticeTimer;

      const isExternalBlankLink = (anchor) => {
        if (!(anchor instanceof HTMLAnchorElement)) return false;
        if (anchor.target !== '_blank') return false;
        if (!anchor.href) return false;
        try {
          const url = new URL(anchor.href, window.location.href);
          return (url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== window.location.origin;
        } catch {
          return false;
        }
      };

      const getHostLabel = (href) => {
        try {
          return new URL(href, window.location.href).hostname.replace(/^www\./, '');
        } catch {
          return 'site externo';
        }
      };

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const anchor = target.closest('a');
        if (!anchor || !isExternalBlankLink(anchor) || !externalNotice) return;

        externalNotice.textContent = `Voce esta saindo para ${getHostLabel(anchor.href)}.`;
        externalNotice.hidden = false;
        externalNotice.classList.add('is-visible');

        window.clearTimeout(externalNoticeTimer);
        externalNoticeTimer = window.setTimeout(() => {
          externalNotice.classList.remove('is-visible');
          externalNotice.hidden = true;
        }, 2200);
      });
    </script>
  </body>
</html>
