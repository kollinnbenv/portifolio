---
import { createCipheriv, pbkdf2Sync, randomBytes } from 'node:crypto';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import projects from '../../../content/projects.json';
import { getSafeExternalUrl } from '../../utils/safeLinks';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const repoUrl = getSafeExternalUrl(project.repoUrl);
const demoUrl = getSafeExternalUrl(project.demoUrl);

// Bloqueio do diario: o conteudo vai cifrado no HTML (AES-256-GCM) e so e decifrado
// no navegador com a senha correta. Assim o dist estatico nao carrega o texto em claro.
// DIARY_LOCK=false desativa o bloqueio e publica o diario aberto.
const isDisabled = (value) =>
  typeof value === 'string' && ['false', '0', 'off', 'no'].includes(value.trim().toLowerCase());

const diaryLockEnabled = !isDisabled(import.meta.env.DIARY_LOCK);
const diaryPassword = (import.meta.env.DIARY_PASSWORD ?? '').trim();

if (diaryLockEnabled && !diaryPassword) {
  throw new Error(
    'DIARY_PASSWORD nao definida. Configure a senha do diario ou use DIARY_LOCK=false para publicar sem bloqueio.'
  );
}

const KDF_ITERATIONS = 250_000;
const diarySalt = diaryLockEnabled ? randomBytes(16) : null;
const diaryKey = diaryLockEnabled
  ? pbkdf2Sync(diaryPassword, diarySalt, KDF_ITERATIONS, 32, 'sha256')
  : null;

// Formato compativel com o WebCrypto do navegador: authTag concatenado ao fim do ciphertext.
const encryptDiaryHtml = (html) => {
  const iv = randomBytes(12);
  const cipher = createCipheriv('aes-256-gcm', diaryKey, iv);
  const encrypted = Buffer.concat([cipher.update(html, 'utf8'), cipher.final()]);

  return {
    iv: iv.toString('base64'),
    payload: Buffer.concat([encrypted, cipher.getAuthTag()]).toString('base64')
  };
};

const toMarkdownLoaders = (globResult) =>
  Object.entries(globResult).map(([file, load]) => ({ file, load }));

const projectEntries = toMarkdownLoaders(import.meta.glob('../../../content/projects/*.md'));
const diaryEntriesNested = toMarkdownLoaders(import.meta.glob('../../../content/projects/*/diary/*.md'));
const diaryEntriesFlat = toMarkdownLoaders(import.meta.glob('../../../content/projects/*/*.md'));

const entryLoader = projectEntries.find((item) => item.file.endsWith(`/${project.slug}.md`));
const projectDiaryFolder = typeof project.diaryFolder === 'string' && project.diaryFolder.trim()
  ? project.diaryFolder.trim()
  : project.slug;
const projectDiaryNestedPath = `/content/projects/${projectDiaryFolder}/diary/`;
const projectDiaryFlatPath = `/content/projects/${projectDiaryFolder}/`;
const projectDiaryEntries = [
  ...diaryEntriesNested.filter((item) => item.file.includes(projectDiaryNestedPath)),
  ...diaryEntriesFlat.filter(
    (item) =>
      item.file.includes(projectDiaryFlatPath) &&
      !item.file.includes('/diary/') &&
      !item.file.endsWith(`/${project.slug}.md`)
  )
];

// Aceita os formatos usados no frontmatter: YYYY-MM-DD, DD-MM-YYYY, YYYY-MM e MM-YYYY.
// Retorna tambem a precisao, para nao inventar dia em data que so tem mes/ano.
const toDate = (dateInput) => {
  if (typeof dateInput !== 'string' || !dateInput.trim()) return null;

  const raw = dateInput.trim().replace(/\//g, '-');
  let year;
  let month;
  let day = 1;
  let precision = 'month';

  let match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (match) {
    [, year, month, day] = match;
    precision = 'day';
  } else if ((match = raw.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/))) {
    [, day, month, year] = match;
    precision = 'day';
  } else if ((match = raw.match(/^(\d{4})-(\d{1,2})$/))) {
    [, year, month] = match;
  } else if ((match = raw.match(/^(\d{1,2})-(\d{4})$/))) {
    [, month, year] = match;
  } else {
    return null;
  }

  const yearNumber = Number(year);
  const monthNumber = Number(month);
  const dayNumber = Number(day);

  if (monthNumber < 1 || monthNumber > 12 || dayNumber < 1 || dayNumber > 31) return null;

  const parsed = new Date(yearNumber, monthNumber - 1, dayNumber);
  if (Number.isNaN(parsed.getTime()) || parsed.getMonth() !== monthNumber - 1) return null;

  return { date: parsed, precision };
};

const formatDateLabel = ({ date, precision }) =>
  date.toLocaleDateString(
    'pt-BR',
    precision === 'day'
      ? { day: '2-digit', month: 'short', year: 'numeric' }
      : { month: 'long', year: 'numeric' }
  );

const diaryPosts = (
  await Promise.all(
    projectDiaryEntries
      .map(async ({ file, load }) => {
        const diaryEntry = await load();
        const frontmatter = diaryEntry.frontmatter ?? {};
        const parsedDate = toDate(frontmatter.date);

        let cipher = null;
        if (diaryLockEnabled) {
          if (typeof diaryEntry.compiledContent !== 'function') {
            throw new Error(`Nao foi possivel obter o HTML compilado de ${file} para cifrar o diario.`);
          }
          cipher = encryptDiaryHtml(await diaryEntry.compiledContent());
        }

        const fileName = file.split('/').pop()?.replace(/\.md$/, '') ?? 'post';
        const fallbackTitle = fileName
          .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
          .replace(/[-_]/g, ' ')
          .trim();

        return {
          slug: fileName,
          title: typeof frontmatter.title === 'string' && frontmatter.title.trim()
            ? frontmatter.title.trim()
            : fallbackTitle || 'Post',
          summary: typeof frontmatter.summary === 'string' ? frontmatter.summary.trim() : '',
          dateSort: parsedDate ? parsedDate.date.getTime() : 0,
          dateLabel: parsedDate ? formatDateLabel(parsedDate) : 'Data nao informada',
          Content: diaryEntry.Content,
          cipher
        };
      })
  )
).sort((a, b) => {
  // Ordem cronologica crescente: fase 1 primeiro, ultima fase por ultimo.
  // Entradas sem data valida ficam no fim; empate de data desempata pelo nome do arquivo.
  if (Boolean(a.dateSort) !== Boolean(b.dateSort)) return a.dateSort ? -1 : 1;
  if (a.dateSort !== b.dateSort) return a.dateSort - b.dateSort;
  return a.slug.localeCompare(b.slug, 'pt-BR', { numeric: true });
});

if (!entryLoader && diaryPosts.length === 0) {
  throw new Error(`Conteudo nao encontrado para ${project.slug}`);
}

let Content = null;
let headings = [];
if (entryLoader) {
  const loadedEntry = await entryLoader.load();
  Content = loadedEntry.Content;
  headings = loadedEntry.getHeadings
    ? (await loadedEntry.getHeadings()).filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    : [];
}

const tocItems = [
  ...headings,
  ...diaryPosts.map((post) => ({
    slug: `diary-${post.slug}`,
    text: post.title
  }))
];
---
<BaseLayout title={project.title} description={project.summary}>
  <section class="page-hero">
    <p class="summary">Projeto</p>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
    <div class="tag-row">
      {project.tags.map((tag) => (
        <Tag label={tag} />
      ))}
    </div>
    <p class="impact"><span>Impacto:</span> {project.impact}</p>
    <div class="cta-row">
      {repoUrl ? (
        <a class="button" href={repoUrl} target="_blank" rel="noopener noreferrer">Repo</a>
      ) : null}
      {demoUrl ? (
        <a class="button" href={demoUrl} target="_blank" rel="noopener noreferrer">Demo</a>
      ) : null}
      <a class="button" href={`${base}projects/`}>Voltar</a>
    </div>
  </section>

  <section class="project-layout section">
    <div class="project-main">
      {Content ? (
        <article class="project-content">
          <Content />
        </article>
      ) : null}

      {diaryPosts.length ? (
        <section class="project-diary" aria-label="Diario do projeto">
          <h2>Diario do projeto</h2>
          {diaryLockEnabled ? (
            <form
              class="project-diary-lock"
              data-diary-lock
              data-salt={diarySalt.toString('base64')}
              data-iterations={KDF_ITERATIONS}
            >
              <label for="diary-password">
                Os posts do diario sao privados. Informe a senha para liberar a leitura.
              </label>
              <div class="project-diary-lock-row">
                <input
                  id="diary-password"
                  name="diary-password"
                  type="password"
                  autocomplete="current-password"
                  required
                />
                <button class="button" type="submit">Liberar</button>
              </div>
              <p class="project-diary-lock-status" data-diary-status role="status" aria-live="polite"></p>
            </form>
          ) : null}
          <div class="project-diary-list">
            {diaryPosts.map((post) => {
              const PostContent = post.Content;
              return (
                <article class="project-diary-post" id={`diary-${post.slug}`}>
                  <details class="project-diary-toggle">
                    <summary class="project-diary-summary">
                      <header class="project-diary-header">
                        <p class="summary">{post.dateLabel}</p>
                        <h3>{post.title}</h3>
                        {post.summary ? <p>{post.summary}</p> : null}
                      </header>
                      <span class="project-diary-indicator" aria-hidden="true"></span>
                    </summary>
                    <div class="project-diary-body">
                      {post.cipher ? (
                        <div
                          class="project-diary-cipher"
                          data-diary-cipher
                          data-iv={post.cipher.iv}
                          data-payload={post.cipher.payload}
                        >
                          <p>Conteudo protegido por senha.</p>
                        </div>
                      ) : (
                        <PostContent />
                      )}
                    </div>
                  </details>
                </article>
              );
            })}
          </div>
        </section>
      ) : null}
    </div>

    {tocItems.length ? (
      <aside class="project-toc" aria-label="Tabela de conteudos">
        <h2>Conteudos</h2>
        <ul>
          {tocItems.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    ) : null}
  </section>

  <script is:inline>
    // Posts do diario ficam dentro de <details> fechado: abre o alvo antes de rolar ate ele.
    const revealDiaryPost = (hash, shouldScroll) => {
      if (!hash || hash.length < 2) return;

      const post = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (!post) return;

      const details = post.querySelector('details');
      if (details) details.open = true;

      if (shouldScroll) {
        post.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const anchor = target.closest('a[href^="#"]');
      if (!anchor) return;

      revealDiaryPost(anchor.getAttribute('href'), false);
    });

    window.addEventListener('hashchange', () => revealDiaryPost(window.location.hash, true));
    revealDiaryPost(window.location.hash, true);
  </script>

  <script is:inline>
    // Decifra o diario no navegador. A chave vem da senha via PBKDF2; nada dela fica no HTML.
    (() => {
      const lockForm = document.querySelector('[data-diary-lock]');
      if (!lockForm) return;

      const statusField = lockForm.querySelector('[data-diary-status]');
      const passwordField = lockForm.querySelector('input[type="password"]');
      const storageKey = 'diary-password';
      const encoder = new TextEncoder();
      const decoder = new TextDecoder();

      const fromBase64 = (value) => Uint8Array.from(atob(value), (char) => char.charCodeAt(0));

      const setStatus = (message) => {
        if (statusField) statusField.textContent = message;
      };

      const readStoredPassword = () => {
        try {
          return sessionStorage.getItem(storageKey);
        } catch {
          return null;
        }
      };

      const storePassword = (password) => {
        try {
          sessionStorage.setItem(storageKey, password);
        } catch {
          // Sem sessionStorage a senha e pedida de novo na proxima pagina.
        }
      };

      const forgetPassword = () => {
        try {
          sessionStorage.removeItem(storageKey);
        } catch {
          // Nada a fazer.
        }
      };

      const deriveKey = async (password) => {
        const material = await crypto.subtle.importKey(
          'raw',
          encoder.encode(password),
          'PBKDF2',
          false,
          ['deriveKey']
        );

        return crypto.subtle.deriveKey(
          {
            name: 'PBKDF2',
            salt: fromBase64(lockForm.dataset.salt),
            iterations: Number(lockForm.dataset.iterations),
            hash: 'SHA-256'
          },
          material,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt']
        );
      };

      // Decifra tudo antes de escrever no DOM: senha errada falha sem deixar post pela metade.
      const unlock = async (password) => {
        const targets = Array.from(document.querySelectorAll('[data-diary-cipher]'));
        if (!targets.length) return;

        const key = await deriveKey(password);
        const revealed = [];

        for (const target of targets) {
          const plain = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: fromBase64(target.dataset.iv) },
            key,
            fromBase64(target.dataset.payload)
          );
          revealed.push([target, decoder.decode(plain)]);
        }

        for (const [target, html] of revealed) {
          target.innerHTML = html;
          target.classList.remove('project-diary-cipher');
          target.removeAttribute('data-diary-cipher');
          target.removeAttribute('data-iv');
          target.removeAttribute('data-payload');
        }

        lockForm.hidden = true;
      };

      lockForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!window.crypto?.subtle) {
          setStatus('Este navegador precisa de HTTPS (ou localhost) para liberar o diario.');
          return;
        }

        const password = passwordField?.value ?? '';
        if (!password) return;

        setStatus('Verificando...');

        try {
          await unlock(password);
          storePassword(password);
        } catch {
          setStatus('Senha incorreta.');
          passwordField?.select();
        }
      });

      const storedPassword = readStoredPassword();
      if (storedPassword && window.crypto?.subtle) {
        unlock(storedPassword).catch(forgetPassword);
      }
    })();
  </script>
</BaseLayout>
