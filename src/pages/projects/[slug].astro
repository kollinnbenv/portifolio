---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import projects from '../../../content/projects.json';
import { getSafeExternalUrl } from '../../utils/safeLinks';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const repoUrl = getSafeExternalUrl(project.repoUrl);
const demoUrl = getSafeExternalUrl(project.demoUrl);

const toMarkdownLoaders = (globResult) =>
  Object.entries(globResult).map(([file, load]) => ({ file, load }));

const projectEntries = toMarkdownLoaders(import.meta.glob('../../../content/projects/*.md'));
const diaryEntriesNested = toMarkdownLoaders(import.meta.glob('../../../content/projects/*/diary/*.md'));
const diaryEntriesFlat = toMarkdownLoaders(import.meta.glob('../../../content/projects/*/*.md'));

const entryLoader = projectEntries.find((item) => item.file.endsWith(`/${project.slug}.md`));
const projectDiaryFolder = typeof project.diaryFolder === 'string' && project.diaryFolder.trim()
  ? project.diaryFolder.trim()
  : project.slug;
const projectDiaryNestedPath = `/content/projects/${projectDiaryFolder}/diary/`;
const projectDiaryFlatPath = `/content/projects/${projectDiaryFolder}/`;
const projectDiaryEntries = [
  ...diaryEntriesNested.filter((item) => item.file.includes(projectDiaryNestedPath)),
  ...diaryEntriesFlat.filter(
    (item) =>
      item.file.includes(projectDiaryFlatPath) &&
      !item.file.includes('/diary/') &&
      !item.file.endsWith(`/${project.slug}.md`)
  )
];

// Aceita os formatos usados no frontmatter: YYYY-MM-DD, DD-MM-YYYY, YYYY-MM e MM-YYYY.
// Retorna tambem a precisao, para nao inventar dia em data que so tem mes/ano.
const toDate = (dateInput) => {
  if (typeof dateInput !== 'string' || !dateInput.trim()) return null;

  const raw = dateInput.trim().replace(/\//g, '-');
  let year;
  let month;
  let day = 1;
  let precision = 'month';

  let match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (match) {
    [, year, month, day] = match;
    precision = 'day';
  } else if ((match = raw.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/))) {
    [, day, month, year] = match;
    precision = 'day';
  } else if ((match = raw.match(/^(\d{4})-(\d{1,2})$/))) {
    [, year, month] = match;
  } else if ((match = raw.match(/^(\d{1,2})-(\d{4})$/))) {
    [, month, year] = match;
  } else {
    return null;
  }

  const yearNumber = Number(year);
  const monthNumber = Number(month);
  const dayNumber = Number(day);

  if (monthNumber < 1 || monthNumber > 12 || dayNumber < 1 || dayNumber > 31) return null;

  const parsed = new Date(yearNumber, monthNumber - 1, dayNumber);
  if (Number.isNaN(parsed.getTime()) || parsed.getMonth() !== monthNumber - 1) return null;

  return { date: parsed, precision };
};

const formatDateLabel = ({ date, precision }) =>
  date.toLocaleDateString(
    'pt-BR',
    precision === 'day'
      ? { day: '2-digit', month: 'short', year: 'numeric' }
      : { month: 'long', year: 'numeric' }
  );

const diaryPosts = (
  await Promise.all(
    projectDiaryEntries
      .map(async ({ file, load }) => {
        const diaryEntry = await load();
        const frontmatter = diaryEntry.frontmatter ?? {};
        const parsedDate = toDate(frontmatter.date);
        const fileName = file.split('/').pop()?.replace(/\.md$/, '') ?? 'post';
        const fallbackTitle = fileName
          .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
          .replace(/[-_]/g, ' ')
          .trim();

        return {
          slug: fileName,
          title: typeof frontmatter.title === 'string' && frontmatter.title.trim()
            ? frontmatter.title.trim()
            : fallbackTitle || 'Post',
          summary: typeof frontmatter.summary === 'string' ? frontmatter.summary.trim() : '',
          dateSort: parsedDate ? parsedDate.date.getTime() : 0,
          dateLabel: parsedDate ? formatDateLabel(parsedDate) : 'Data nao informada',
          Content: diaryEntry.Content
        };
      })
  )
).sort((a, b) => {
  // Ordem cronologica crescente: fase 1 primeiro, ultima fase por ultimo.
  // Entradas sem data valida ficam no fim; empate de data desempata pelo nome do arquivo.
  if (Boolean(a.dateSort) !== Boolean(b.dateSort)) return a.dateSort ? -1 : 1;
  if (a.dateSort !== b.dateSort) return a.dateSort - b.dateSort;
  return a.slug.localeCompare(b.slug, 'pt-BR', { numeric: true });
});

if (!entryLoader && diaryPosts.length === 0) {
  throw new Error(`Conteudo nao encontrado para ${project.slug}`);
}

let Content = null;
let headings = [];
if (entryLoader) {
  const loadedEntry = await entryLoader.load();
  Content = loadedEntry.Content;
  headings = loadedEntry.getHeadings
    ? (await loadedEntry.getHeadings()).filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    : [];
}

const tocItems = [
  ...headings,
  ...diaryPosts.map((post) => ({
    slug: `diary-${post.slug}`,
    text: post.title
  }))
];
---
<BaseLayout title={project.title} description={project.summary}>
  <section class="page-hero">
    <p class="summary">Projeto</p>
    <h1>{project.title}</h1>
    <p>{project.summary}</p>
    <div class="tag-row">
      {project.tags.map((tag) => (
        <Tag label={tag} />
      ))}
    </div>
    <p class="impact"><span>Impacto:</span> {project.impact}</p>
    <div class="cta-row">
      {repoUrl ? (
        <a class="button" href={repoUrl} target="_blank" rel="noopener noreferrer">Repo</a>
      ) : null}
      {demoUrl ? (
        <a class="button" href={demoUrl} target="_blank" rel="noopener noreferrer">Demo</a>
      ) : null}
      <a class="button" href={`${base}projects/`}>Voltar</a>
    </div>
  </section>

  <section class="project-layout section">
    <div class="project-main">
      {Content ? (
        <article class="project-content">
          <Content />
        </article>
      ) : null}

      {diaryPosts.length ? (
        <section class="project-diary" aria-label="Diario do projeto">
          <h2>Diario do projeto</h2>
          <div class="project-diary-list">
            {diaryPosts.map((post) => {
              const PostContent = post.Content;
              return (
                <article class="project-diary-post" id={`diary-${post.slug}`}>
                  <details class="project-diary-toggle">
                    <summary class="project-diary-summary">
                      <header class="project-diary-header">
                        <p class="summary">{post.dateLabel}</p>
                        <h3>{post.title}</h3>
                        {post.summary ? <p>{post.summary}</p> : null}
                      </header>
                      <span class="project-diary-indicator" aria-hidden="true"></span>
                    </summary>
                    <div class="project-diary-body">
                      <PostContent />
                    </div>
                  </details>
                </article>
              );
            })}
          </div>
        </section>
      ) : null}
    </div>

    {tocItems.length ? (
      <aside class="project-toc" aria-label="Tabela de conteudos">
        <h2>Conteudos</h2>
        <ul>
          {tocItems.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    ) : null}
  </section>

  <script is:inline>
    // Posts do diario ficam dentro de <details> fechado: abre o alvo antes de rolar ate ele.
    const revealDiaryPost = (hash, shouldScroll) => {
      if (!hash || hash.length < 2) return;

      const post = document.getElementById(decodeURIComponent(hash.slice(1)));
      if (!post) return;

      const details = post.querySelector('details');
      if (details) details.open = true;

      if (shouldScroll) {
        post.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const anchor = target.closest('a[href^="#"]');
      if (!anchor) return;

      revealDiaryPost(anchor.getAttribute('href'), false);
    });

    window.addEventListener('hashchange', () => revealDiaryPost(window.location.hash, true));
    revealDiaryPost(window.location.hash, true);
  </script>
</BaseLayout>
